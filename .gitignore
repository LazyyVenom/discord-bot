# Virtual Environment
env/
venv/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Temporary files
temp*

# Environment Variables
# .env* so backups and variants can never be committed either.
# .env.example is already tracked and stays that way.
.env
.env.*
!.env.example

# Database files
*.db
*.sqlite
*.sqlite3
app.db.bak*
app.db.discarded-*

# Scratch working material (question banks live in data/questions/, tracked)
for_claude/

# Generated docs, specs and plans - not part of the repo
docs/

# IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Logs
*.log
